{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "local": {
      "name": "Local OpenAI-compatible model",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": [
        "LOCAL_LLM_API_KEY"
      ],
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "headerTimeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "your-local-model": {
          "name": "Your local model",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "input": 106496,
            "output": 24576
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 16384
    },
    "buffer": 32768
  }
}
