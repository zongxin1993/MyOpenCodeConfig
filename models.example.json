{
  "version": 1,
  "routing": {
    "cloud_model": "session"
  },
  "extensions": {
    "context7": true,
    "quota": true,
    "plannotator": true,
    "worktree": true
  },
  "defaults": {
    "cloud": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "variant": "high"
    },
    "local": {
      "provider": "local",
      "model": "your-local-model",
      "variant": null
    }
  },
  "roles": {},
  "execution": {
    "rtk": {
      "enabled": true,
      "profile": "safe-output"
    },
    "ast_grep": {
      "enabled": true
    },
    "worker_skill": true,
    "rust_skills": [
      "ownership",
      "error-handling",
      "concurrency"
    ],
    "serena": {
      "mode": "off"
    },
    "browser": {
      "mode": "off"
    }
  }
}
