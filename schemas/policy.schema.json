{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z][A-Za-z0-9_.-]*"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "parser": {
            "enum": [
              "unittest",
              "json"
            ],
            "type": "string"
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "min_checks": {
            "type": "integer",
            "minimum": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "argv",
          "parser",
          "timeout",
          "min_checks",
          "environment",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "lanes"
  ],
  "additionalProperties": false
}
